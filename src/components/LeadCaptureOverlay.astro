---
interface Props {
  cottageSlug: string;
  cottageName: string;
}

const { cottageSlug, cottageName } = Astro.props;
---

<div
  id="pbc-lead-overlay"
  class="pbc-lead-overlay"
  data-cottage-slug={cottageSlug}
  data-cottage-name={cottageName}
  role="dialog"
  aria-modal="false"
  aria-labelledby="pbc-lead-title"
  hidden
>
  <div class="pbc-lead-card">
    <button type="button" class="pbc-lead-close" aria-label="Dismiss" data-lead-close>&times;</button>

    <div class="pbc-lead-icon" aria-hidden="true">✉️</div>

    <h2 id="pbc-lead-title" class="pbc-lead-headline">
      Want Lake Erie picks sent to your email?
    </h2>
    <p class="pbc-lead-sub">
      We'll send a short guide with our favorite wineries, restaurants, and seasonal tips — plus early access to future {cottageName} openings.
    </p>

    <form class="pbc-lead-form" data-lead-form novalidate>
      <label class="pbc-lead-field">
        <span class="pbc-lead-label">Your email</span>
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="you@example.com"
          class="pbc-lead-input"
          data-lead-email
        />
      </label>

      <label class="pbc-lead-consent">
        <input type="checkbox" name="consent" required data-lead-consent />
        <span>
          Email me about future Pearl Beach stays. Unsubscribe anytime.
        </span>
      </label>

      <div class="pbc-lead-actions">
        <button type="button" class="pbc-lead-later" data-lead-close>Maybe later</button>
        <button type="submit" class="pbc-lead-submit" data-lead-submit>Send me picks</button>
      </div>

      <p class="pbc-lead-status" role="status" aria-live="polite" data-lead-status></p>
    </form>
  </div>
</div>

<script is:inline>
  (function () {
    const LEAD_WEBHOOK =
      'https://zax76.app.n8n.cloud/webhook/pbc-lead-capture';
    const DISMISS_KEY = 'pbc-lead-dismissed';
    const SUBMIT_KEY = 'pbc-lead-submitted';

    function init() {
      const overlay = document.getElementById('pbc-lead-overlay');
      if (!overlay) return;

      const cottageSlug = overlay.getAttribute('data-cottage-slug') || '';
      const form = overlay.querySelector('[data-lead-form]');
      const emailInput = overlay.querySelector('[data-lead-email]');
      const consentInput = overlay.querySelector('[data-lead-consent]');
      const statusEl = overlay.querySelector('[data-lead-status]');
      const closeButtons = overlay.querySelectorAll('[data-lead-close]');
      const openTriggers = document.querySelectorAll('[data-lead-open]');

      const alreadySubmitted = () => sessionStorage.getItem(SUBMIT_KEY) === '1';
      const alreadyDismissed = () => sessionStorage.getItem(DISMISS_KEY) === '1';

      function showOverlay(opts) {
        const force = opts && opts.force;
        if (!force && (alreadySubmitted() || alreadyDismissed())) return;
        overlay.hidden = false;
        requestAnimationFrame(() => overlay.classList.add('is-visible'));
      }

      function hideOverlay(markDismissed) {
        overlay.classList.remove('is-visible');
        setTimeout(() => {
          overlay.hidden = true;
        }, 220);
        if (markDismissed) sessionStorage.setItem(DISMISS_KEY, '1');
      }

      closeButtons.forEach((btn) =>
        btn.addEventListener('click', () => hideOverlay(true))
      );

      // Header link / any [data-lead-open] element reopens the overlay
      openTriggers.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          if (alreadySubmitted()) {
            // Already submitted — nothing to do
            return;
          }
          sessionStorage.removeItem(DISMISS_KEY);
          showOverlay({ force: true });
        });
      });

      // Hide any "join list" triggers if they already submitted
      if (alreadySubmitted()) {
        openTriggers.forEach((btn) => {
          btn.hidden = true;
        });
      }

      // Trigger: show overlay ~5s after the USER sends their first message
      // (waits for user message so the initialMessages from n8n don't trigger it)
      const chatRoot = document.getElementById('n8n-chat');
      if (!chatRoot) return;

      let triggered = false;
      function maybeTrigger() {
        if (triggered || alreadySubmitted() || alreadyDismissed()) return;
        const userMessages = chatRoot.querySelectorAll('.chat-message-from-user');
        if (userMessages.length >= 1) {
          triggered = true;
          observer.disconnect();
          setTimeout(() => showOverlay(), 5000);
        }
      }

      const observer = new MutationObserver(maybeTrigger);
      observer.observe(chatRoot, { childList: true, subtree: true });
      maybeTrigger();

      // Submit
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          const email = (emailInput.value || '').trim();
          const consent = !!consentInput.checked;

          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            statusEl.textContent = 'Please enter a valid email.';
            statusEl.className = 'pbc-lead-status is-error';
            return;
          }
          if (!consent) {
            statusEl.textContent = 'Please tick the consent box to continue.';
            statusEl.className = 'pbc-lead-status is-error';
            return;
          }

          const submitBtn = overlay.querySelector('[data-lead-submit]');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending…';
          }

          try {
            const res = await fetch(LEAD_WEBHOOK, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email,
                cottage: cottageSlug,
                source: 'concierge-qr',
                consent: true,
                timestamp: new Date().toISOString(),
                userAgent: navigator.userAgent,
              }),
            });
            if (!res.ok) throw new Error('Network error');

            sessionStorage.setItem(SUBMIT_KEY, '1');
            statusEl.textContent = 'Thanks! Keep an eye on your inbox.';
            statusEl.className = 'pbc-lead-status is-success';
            setTimeout(() => hideOverlay(false), 2500);
            openTriggers.forEach((btn) => { btn.hidden = true; });
          } catch (err) {
            statusEl.textContent = 'Sorry — something went wrong. Try again later.';
            statusEl.className = 'pbc-lead-status is-error';
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Send me picks';
            }
          }
        });
      }

    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .pbc-lead-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(61, 79, 71, 0.45);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
  }

  .pbc-lead-overlay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .pbc-lead-card {
    position: relative;
    width: 100%;
    max-width: 520px;
    background: #FBF8F4;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    padding: 22px 22px calc(22px + env(safe-area-inset-bottom)) 22px;
    box-shadow: 0 -14px 40px rgba(61, 79, 71, 0.18);
    transform: translateY(24px);
    transition: transform 0.24s ease;
    font-family: 'Source Sans 3', system-ui, sans-serif;
  }

  .pbc-lead-overlay.is-visible .pbc-lead-card {
    transform: translateY(0);
  }

  @media (min-width: 640px) {
    .pbc-lead-overlay {
      align-items: center;
    }
    .pbc-lead-card {
      border-radius: 20px;
      padding: 26px;
    }
  }

  .pbc-lead-close {
    position: absolute;
    top: 8px;
    right: 12px;
    background: transparent;
    border: none;
    font-size: 26px;
    line-height: 1;
    color: #7A8680;
    cursor: pointer;
    padding: 6px 10px;
  }

  .pbc-lead-close:hover {
    color: #3D4F47;
  }

  .pbc-lead-icon {
    font-size: 22px;
    margin-bottom: 4px;
  }

  .pbc-lead-headline {
    font-family: 'Lora', Georgia, serif;
    font-size: 19px;
    font-weight: 600;
    color: #3D4F47;
    margin: 0 0 6px;
    padding-right: 20px;
  }

  .pbc-lead-sub {
    font-size: 14px;
    line-height: 1.45;
    color: #5A6B64;
    margin: 0 0 14px;
  }

  .pbc-lead-field {
    display: block;
    margin-bottom: 10px;
  }

  .pbc-lead-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #5A6B64;
    margin-bottom: 4px;
  }

  .pbc-lead-input {
    width: 100%;
    font-size: 16px;
    padding: 11px 14px;
    border: 1px solid #EDE8E0;
    border-radius: 12px;
    background: #fff;
    color: #3D4F47;
    font-family: inherit;
    box-sizing: border-box;
  }

  .pbc-lead-input:focus {
    outline: none;
    border-color: #C4956A;
    box-shadow: 0 0 0 3px rgba(196, 149, 106, 0.18);
  }

  .pbc-lead-consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13px;
    line-height: 1.4;
    color: #5A6B64;
    margin: 6px 0 14px;
    cursor: pointer;
  }

  .pbc-lead-consent input {
    margin-top: 3px;
    accent-color: #5D7566;
  }

  .pbc-lead-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .pbc-lead-submit,
  .pbc-lead-later {
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    padding: 11px 18px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    flex: 1 1 140px;
  }

  .pbc-lead-submit {
    background: linear-gradient(135deg, #C4956A 0%, #A67B4F 100%);
    color: white;
    box-shadow: 0 4px 14px rgba(196, 149, 106, 0.28);
  }

  .pbc-lead-submit:hover {
    background: linear-gradient(135deg, #A67B4F 0%, #8A6340 100%);
  }

  .pbc-lead-submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .pbc-lead-later {
    background: transparent;
    color: #5A6B64;
  }

  .pbc-lead-later:hover {
    color: #3D4F47;
  }

  .pbc-lead-status {
    font-size: 13px;
    margin: 12px 0 0;
    min-height: 1em;
  }

  .pbc-lead-status.is-error {
    color: #B84B3C;
  }

  .pbc-lead-status.is-success {
    color: #4F6B5A;
  }

</style>
