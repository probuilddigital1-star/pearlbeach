    {
      "parameters": {
        "jsCode": "// Derive presentation-only fields for the email + sheet row.\n// Inputs (from the Pages Function payload):\n//   property_slug, property_name, vrbo_id,\n//   check_in (YYYY-MM-DD), check_out (YYYY-MM-DD),\n//   nights, guests,\n//   name, email, phone, message, message_html,\n//   submitted_at (ISO UTC), dates_verified_available, inquiry_id\n\nconst items = $input.all();\nconst out = [];\n\nfor (const it of items) {\n  // n8n webhook wraps the POST body in either `body` (newer) or at the top level.\n  const item = (it.json && it.json.body && typeof it.json.body === 'object') ? it.json.body : it.json;\n\n  const checkIn = DateTime.fromISO(item.check_in);\n  const checkOut = DateTime.fromISO(item.check_out);\n  const submittedAt = DateTime\n    .fromISO(item.submitted_at, { zone: 'utc' })\n    .setZone('America/New_York');\n\n  // tel: link â€” preserve a leading + if present, strip all other non-digits.\n  const rawPhone = String(item.phone || '');\n  const hasPlus = rawPhone.trim().startsWith('+');\n  const digits = rawPhone.replace(/\\D/g, '');\n  const telLink = `tel:${hasPlus ? '+' : ''}${digits}`;\n\n  // VRBO owner calendar deep link â€” best-guess pattern. Verify on first\n  // real inquiry; if it lands on the wrong page, edit this template.\n  const vrboCalendarUrl = `https://www.vrbo.com/p/calendar/321.${item.vrbo_id}.${item.vrbo_id}`;\n\n  out.push({\n    json: {\n      ...item,\n      subject: `Inquiry: ${item.property_name} Â· ${checkIn.toFormat('LLL d')}â€“${checkOut.toFormat('LLL d')} Â· ${item.name}`,\n      check_in_full: checkIn.toFormat('cccc, LLLL d, yyyy'),\n      check_out_full: checkOut.toFormat('cccc, LLLL d, yyyy'),\n      submitted_at_pretty: `${submittedAt.toFormat('M/d/yyyy, h:mm a')} ET`,\n      mailto_link: `mailto:${item.email}?subject=${encodeURIComponent('Re: Pearl Beach inquiry (' + item.inquiry_id + ')')}`,\n      tel_link: telLink,\n      vrbo_calendar_url: vrboCalendarUrl,\n    },\n  });\n}\n\nreturn out;\n"
      },
      "id": "8e9366e4-4af4-49c7-88b8-8090513c8531",
      "name": "Derive Presentation Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "sendTo": "zckpearson@gmail.com, jjpea1@gmail.com",
        "subject": "={{ $json.subject }}",
        "message": "=<div style=\"font-family:-apple-system,system-ui,sans-serif;max-width:560px;color:#222\">\n  <h2 style=\"color:#5D7566;margin:0 0 8px\">{{ $json.property_name }}</h2>\n  <p style=\"font-size:18px;margin:0 0 4px\"><strong>{{ $json.check_in_full }}</strong> &rarr; <strong>{{ $json.check_out_full }}</strong></p>\n  <p style=\"color:#666;margin:0 0 16px\">{{ $json.nights }} nights &middot; {{ $json.guests }} guests</p>\n\n  <div style=\"background:#F5F0E8;padding:16px;border-radius:8px;margin:0 0 16px\">\n    <p style=\"margin:0 0 8px\"><strong>{{ $json.name }}</strong></p>\n    <p style=\"margin:0 0 4px\">&#x1F4E7; <a href=\"{{ $json.mailto_link }}\" style=\"color:#C4956A\">{{ $json.email }}</a></p>\n    <p style=\"margin:0\">&#x1F4DE; <a href=\"{{ $json.tel_link }}\" style=\"color:#C4956A\">{{ $json.phone }}</a></p>\n  </div>\n\n  <div style=\"margin:0 0 16px\">\n    <p style=\"font-size:13px;color:#666;margin:0 0 6px\">Their message:</p>\n    <div style=\"background:#FBF8F4;border-left:3px solid #5D7566;padding:12px 16px;font-size:14px;line-height:1.5\">{{ $json.message_html || '<em style=\"color:#999\">(no message)</em>' }}</div>\n  </div>\n\n  <p style=\"margin:0 0 20px\">\n    <a href=\"{{ $json.vrbo_calendar_url }}\" style=\"display:inline-block;background:#C4956A;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;font-weight:600\">\n      Block these dates on VRBO &rarr;\n    </a>\n  </p>\n\n  <p style=\"font-size:12px;color:#888;margin:0\">\n    &#x2713; Dates verified available at submit ({{ $json.submitted_at_pretty }})<br>\n    Inquiry ID: <code style=\"font-family:monospace\">{{ $json.inquiry_id }}</code>\n  </p>\n</div>",
        "options": {
          "replyTo": "={{ $json.email }}"
        }
      },
